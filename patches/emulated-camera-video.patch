 namespace android {
 
+namespace {
+
+// The vendor camera domain can read this path without granting it access to
+// /data.  A Magisk overlay supplies the file at runtime.  The file contains
+// consecutive 640x360 I420 frames generated by instalar-videocam.ps1.
+constexpr char kVideoFramePath[] = "/vendor/etc/config/emu_camera_video.i420";
+constexpr char kVideoControlPath[] = "/vendor/etc/config/emu_camera_control.txt";
+constexpr uint32_t kVideoFrameWidth = 640;
+constexpr uint32_t kVideoFrameHeight = 360;
+
+bool ReadVideoI420Frame(YCbCrPlanes* planes, size_t* width,
+                        size_t* height) {
+  static std::ifstream source;
+  static std::vector<uint8_t> frame;
+  static uint64_t generation = 0;
+  static bool has_frame = false;
+  bool paused = false;
+  uint64_t requested_generation = generation;
+  std::ifstream control(kVideoControlPath);
+  if (control.is_open()) {
+    std::string state;
+    if (control >> state >> requested_generation) paused = state == "pause";
+  }
+
+  if (requested_generation != generation) {
+    generation = requested_generation;
+    source.clear();
+    if (source.is_open()) source.seekg(0, std::ios::beg);
+    has_frame = false;
+  }
+
+  const size_t frame_size = kVideoFrameWidth * kVideoFrameHeight * 3 / 2;
+  if (frame.size() != frame_size) frame.resize(frame_size);
+  if (!source.is_open()) source.open(kVideoFramePath, std::ios::binary);
+  if (!source.is_open()) return false;
+
+  if (!paused || !has_frame) {
+    source.read(reinterpret_cast<char*>(frame.data()), frame_size);
+    if (source.gcount() != static_cast<std::streamsize>(frame_size)) {
+      // Loop cleanly when the pre-recorded clip reaches EOF.
+      source.clear();
+      source.seekg(0, std::ios::beg);
+      source.read(reinterpret_cast<char*>(frame.data()), frame_size);
+      if (source.gcount() != static_cast<std::streamsize>(frame_size)) return false;
+    }
+    has_frame = true;
+  }
+
+  *planes = {
+      .img_y = frame.data(),
+      .img_cb = frame.data() + kVideoFrameWidth * kVideoFrameHeight,
+      .img_cr = frame.data() + kVideoFrameWidth * kVideoFrameHeight * 5 / 4,
+      .y_stride = kVideoFrameWidth,
+      .cbcr_stride = kVideoFrameWidth / 2,
+      .cbcr_step = 1};
+  *width = kVideoFrameWidth;
+  *height = kVideoFrameHeight;
+  return true;
+}
+
+}  // namespace
